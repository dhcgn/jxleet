{
  "version": "0.12.0",
  "flags": [
    {
      "short": "d",
      "long": "distance",
      "takesValue": true,
      "valueSpec": "DISTANCE",
      "section": "Basic options",
      "description": "Target visual distance in JND units, range: 0.0 .. 25.0."
    },
    {
      "short": "q",
      "long": "quality",
      "takesValue": true,
      "valueSpec": "QUALITY",
      "section": "Basic options",
      "description": "Internally mapped to --distance, range: 0 .. 100."
    },
    {
      "short": "e",
      "long": "effort",
      "takesValue": true,
      "valueSpec": "EFFORT",
      "section": "Basic options",
      "description": "Encoder effort, range: 1 .. 10, default = 7."
    },
    {
      "short": "V",
      "long": "version",
      "takesValue": false,
      "section": "Basic options",
      "description": "Print encoder library version number and exit."
    },
    {
      "long": "quiet",
      "takesValue": false,
      "section": "Basic options",
      "description": "Minimal printing."
    },
    {
      "short": "v",
      "long": "verbose",
      "takesValue": false,
      "section": "Basic options",
      "description": "Verbose printing; can be repeated and also applies to help (!)."
    },
    {
      "short": "a",
      "long": "alpha_distance",
      "takesValue": true,
      "valueSpec": "DISTANCE",
      "section": "Advanced options",
      "description": "Target visual distance for the alpha channel, range: 0.0 .. 25.0, default = 0.0."
    },
    {
      "short": "p",
      "long": "progressive",
      "takesValue": false,
      "section": "Advanced options",
      "description": "More progressive/responsive decoding."
    },
    {
      "long": "group_order",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Advanced options",
      "description": "Order in which groups are stored in the codestream for progressive rendering, default = 0."
    },
    {
      "long": "container",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Advanced options",
      "description": "0 = do not use the container format unless it is needed."
    },
    {
      "long": "compress_boxes",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Advanced options",
      "description": "Disable/enable Brotli compression for metadata boxes, default = 1. 0 = disable. 1 = enable."
    },
    {
      "long": "brotli_effort",
      "takesValue": true,
      "valueSpec": "EFFORT",
      "section": "Advanced options",
      "description": "Brotli effort, range: 0 .. 11, default = 9."
    },
    {
      "short": "m",
      "long": "modular",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Advanced options",
      "description": "0 = use VarDCT mode. 1 = use modular mode. Default = encoder chooses."
    },
    {
      "short": "j",
      "long": "lossless_jpeg",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Advanced options",
      "description": "0 = decode JPEG input to pixels and reencode. 1 = losslessly transcode JPEG data. Default = 1."
    },
    {
      "long": "num_threads",
      "takesValue": true,
      "valueSpec": "THREADS",
      "section": "Advanced options",
      "description": "Number of worker threads, default = -1."
    },
    {
      "long": "photon_noise_iso",
      "takesValue": true,
      "valueSpec": "ISO_FILM_SPEED",
      "section": "Advanced options",
      "description": "Add noise to the image emulating photographic film or sensor noise, default = 0."
    },
    {
      "long": "intensity_target",
      "takesValue": true,
      "valueSpec": "NITS",
      "section": "Advanced options",
      "description": "Upper bound on the intensity level present in the image, in nits."
    },
    {
      "short": "x",
      "long": "dec-hints",
      "takesValue": true,
      "valueSpec": "key=value",
      "section": "Advanced options",
      "description": "Use with 'raw' formats like PPM which do not store colorspace information"
    },
    {
      "long": "allow_jpeg_reconstruction",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "More advanced options",
      "description": "Disable/enable storing JPEG reconstruction metadata with lossless JPEG transcoding,"
    },
    {
      "long": "codestream_level",
      "takesValue": true,
      "valueSpec": "-1|5|10",
      "section": "More advanced options",
      "description": "The codestream level."
    },
    {
      "long": "buffering",
      "takesValue": true,
      "valueSpec": "-1..3",
      "section": "More advanced options",
      "description": "Controls how much input buffering libjxl uses, affecting memory usage and compression quality."
    },
    {
      "long": "faster_decoding",
      "takesValue": true,
      "valueSpec": "0..4",
      "section": "More advanced options",
      "description": "Higher values improve decode speed at the expense of quality or density, default = 0."
    },
    {
      "long": "premultiply",
      "takesValue": true,
      "valueSpec": "-1|0|1",
      "section": "More advanced options",
      "description": "Force premultiplied (associated) alpha."
    },
    {
      "long": "keep_invisible",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "More advanced options",
      "description": "0 = allow modifying invisible pixels for better density, default for lossy output."
    },
    {
      "long": "center_x",
      "takesValue": true,
      "valueSpec": "-1..XSIZE",
      "section": "More advanced options",
      "description": "Set the horizontal position of center for center-first group ordering, range: [-1 .. xsize)."
    },
    {
      "long": "center_y",
      "takesValue": true,
      "valueSpec": "-1..YSIZE",
      "section": "More advanced options",
      "description": "Set the vertical position of center for center-first group ordering, range: [-1 .. xsize)."
    },
    {
      "long": "progressive_ac",
      "takesValue": false,
      "section": "More advanced options",
      "description": "Use the progressive mode for AC."
    },
    {
      "long": "qprogressive_ac",
      "takesValue": false,
      "section": "More advanced options",
      "description": "Use the progressive mode for AC with shift quantization."
    },
    {
      "long": "progressive_dc",
      "takesValue": true,
      "valueSpec": "-1..2",
      "section": "More advanced options",
      "description": "Number of progressive-DC frames, default = -1. -1 = encoder chooses."
    },
    {
      "long": "resampling",
      "takesValue": true,
      "valueSpec": "-1|1|2|4|8",
      "section": "More advanced options",
      "description": "Resampling for color channels, default = -1."
    },
    {
      "long": "ec_resampling",
      "takesValue": true,
      "valueSpec": "-1|1|2|4|8",
      "section": "More advanced options",
      "description": "Resampling for extra channels. Same as --resampling but for extra channels like alpha."
    },
    {
      "long": "already_downsampled",
      "takesValue": false,
      "section": "More advanced options",
      "description": "Do not downsample before encoding, but still signal that the decoder should upsample."
    },
    {
      "long": "upsampling_mode",
      "takesValue": true,
      "valueSpec": "-1|0|1",
      "section": "More advanced options",
      "description": "Decoder upsampling mode, mostly useful in combination with --already_downsampled."
    },
    {
      "long": "epf",
      "takesValue": true,
      "valueSpec": "-1..3",
      "section": "More advanced options",
      "description": "Edge preserving filter strength, default = -1. -1 = encoder chooses."
    },
    {
      "long": "gaborish",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "More advanced options",
      "description": "0 = don't use the gaborish filter. 1 = use gaborish. Default = encoder chooses."
    },
    {
      "long": "override_bitdepth",
      "takesValue": true,
      "valueSpec": "BITDEPTH",
      "section": "More advanced options",
      "description": "Set the bit depth, default = 0. 0 = use the input image bit depth."
    },
    {
      "long": "noise",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Options for experimentation / benchmarking",
      "description": "Disable/enable adaptive noise generation, default = encoder chooses. 0 = disable. 1 = enable."
    },
    {
      "long": "jpeg_reconstruction_cfl",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Options for experimentation / benchmarking",
      "description": "Disable/enable chroma-from-luma (CFL) for lossless JPEG reconstruction."
    },
    {
      "long": "num_reps",
      "takesValue": true,
      "valueSpec": "REPS",
      "section": "Options for experimentation / benchmarking",
      "description": "How many times to compress, for benchmarking."
    },
    {
      "long": "streaming_input",
      "takesValue": false,
      "section": "Options for experimentation / benchmarking",
      "description": "Enable streaming processing of the input file, supported for PPM and PGM input."
    },
    {
      "long": "streaming_output",
      "takesValue": false,
      "section": "Options for experimentation / benchmarking",
      "description": "Enable incremental writing of the output file."
    },
    {
      "long": "output_mode",
      "takesValue": true,
      "valueSpec": "-1..2",
      "section": "Options for experimentation / benchmarking",
      "description": "Output mode: -1=default (let encoder decide), 0=buffer output internally, 1=streaming with seeking, 2=OOO jxlp (ftyp v1, no seeking required)."
    },
    {
      "long": "disable_output",
      "takesValue": false,
      "section": "Options for experimentation / benchmarking",
      "description": "Do not write an output file."
    },
    {
      "long": "dots",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Options for experimentation / benchmarking",
      "description": "Disable/enable dots generation. 0 = disable. 1 = enable. Default = encoder chooses."
    },
    {
      "long": "patches",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Options for experimentation / benchmarking",
      "description": "Disable/enable patches generation. 0 = disable. 1 = enable. Default = encoder chooses."
    },
    {
      "long": "frame_indexing",
      "takesValue": true,
      "valueSpec": "INDICES",
      "section": "Options for experimentation / benchmarking",
      "description": "INDICES is of the form '^(0*|1[01]*)'. The i-th position indicates whether the i-th"
    },
    {
      "long": "allow_expert_options",
      "takesValue": false,
      "section": "Options for experimentation / benchmarking",
      "description": "Allow setting effort to 11 for somewhat denser lossless compression at an extreme compute cost."
    },
    {
      "long": "disable_perceptual_optimizations",
      "takesValue": false,
      "section": "Options for experimentation / benchmarking",
      "description": "Disable perceptual optimizations."
    },
    {
      "short": "I",
      "long": "iterations",
      "takesValue": true,
      "valueSpec": "PERCENT",
      "section": "Modular mode options",
      "description": "Percentage of pixels used to learn MA trees, default = -1."
    },
    {
      "short": "C",
      "long": "modular_colorspace",
      "takesValue": true,
      "valueSpec": "-1..41",
      "section": "Modular mode options",
      "description": "Color transform, default = -1. -1 = try several per group, depending on effort. 0 = RGB (none)."
    },
    {
      "short": "g",
      "long": "modular_group_size",
      "takesValue": true,
      "valueSpec": "-1..3",
      "section": "Modular mode options",
      "description": "Group size, default = -1."
    },
    {
      "short": "P",
      "long": "modular_predictor",
      "takesValue": true,
      "valueSpec": "0..15",
      "section": "Modular mode options",
      "description": "Predictor(s) to use. 0 = zero. 1 = left. 2 = top. 3 = avg0. 4 = select. 5 = gradient."
    },
    {
      "short": "E",
      "long": "modular_nb_prev_channels",
      "takesValue": true,
      "valueSpec": "-1..11",
      "section": "Modular mode options",
      "description": "Maximum number of previous-channel MA tree properties to use, default -1. -1 = encoder chooses."
    },
    {
      "long": "modular_palette_colors",
      "takesValue": true,
      "valueSpec": "COLORS",
      "section": "Modular mode options",
      "description": "Use palette if number of colors is smaller than or equal to this."
    },
    {
      "long": "modular_lossy_palette",
      "takesValue": false,
      "section": "Modular mode options",
      "description": "Use delta palette in a lossy way; it is recommended to also set --modular_palette_colors=0"
    },
    {
      "short": "X",
      "long": "pre-compact",
      "takesValue": true,
      "valueSpec": "PERCENT",
      "section": "Modular mode options",
      "description": "Use global channel palette if the number of sample values is smaller"
    },
    {
      "short": "Y",
      "long": "post-compact",
      "takesValue": true,
      "valueSpec": "PERCENT",
      "section": "Modular mode options",
      "description": "Use local (per-group) channel palette if the number of sample values is"
    },
    {
      "short": "R",
      "long": "responsive",
      "takesValue": true,
      "valueSpec": "0|1",
      "section": "Modular mode options",
      "description": "0 = don't apply the Squeeze transform. Default for lossless output."
    },
    {
      "short": "h",
      "long": "help",
      "takesValue": false,
      "section": "Modular mode options",
      "description": "Prints this help message. All options are shown above."
    }
  ]
}